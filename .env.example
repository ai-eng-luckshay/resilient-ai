# ── Resilient AI — Environment Configuration ──────────────────────────────
# Copy this file to .env and fill in your values.
# start.sh copies it automatically on first run.

# Application
ENV=dev
LOG_LEVEL=INFO

# ── LLM API Keys ───────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...your-openai-key-here...
GEMINI_API_KEY=...your-gemini-key-here...

# ── LLM Selection ──────────────────────────────────────────────────────────
# Preferred provider key — placed first in the failover chain.
# Full chain is built automatically from llm_provider_map in agent_util.py.
# Available keys: GEMINI_31_FLASH_LITE, GPT4O_MINI, GEMINI_FLASH, GEMINI_25_FLASH
SELECTED_LLM_PROVIDER=GPT4O_MINI

# ── Processor backend ─────────────────────────────────────────────────────
# LANGGRAPH   — fully functional (default)
# GOOGLE_ADK  — extension point stub (see app/agent/processors/google_adk_processor.py)
AGENT_PROCESSOR=LANGGRAPH

# ── Streaming ─────────────────────────────────────────────────────────────
# BUFFERED — sentence-level chunking (voice/IVR friendly)
# RAW      — every token immediately (lowest latency for chat UI)
STREAM_MODE=BUFFERED

# ── Session TTL ───────────────────────────────────────────────────────────
SESSION_TTL_SECONDS=7200          # REST sessions: 2 hours
A2A_CONTEXT_TTL_SECONDS=86400    # A2A context bindings: 24 hours

# ── Redis (optional) ──────────────────────────────────────────────────────
# Set USE_REDIS=true to swap all in-memory stores (session, A2A context,
# A2A tasks) to Redis-backed equivalents — required for multi-worker or
# persistent deployments.
# See app/infra/redis_store.py for implementation details and tradeoffs.
USE_REDIS=false
REDIS_URL=redis://localhost:6379/0

# ── Server ports ──────────────────────────────────────────────────────────
API_PORT=8000
UI_PORT=8501
