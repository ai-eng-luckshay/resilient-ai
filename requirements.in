# Resilient AI — direct dependencies (human-maintained)
# Compiled to requirements.txt by start.sh via pip-compile.
# To manually recompile:
#   pip-compile requirements.in -o requirements.txt
#   pip-sync requirements.txt
#
# Python 3.11+

# Web framework
fastapi==0.116.2
uvicorn[standard]==0.47.0
starlette==0.46.2

# LLM orchestration
