pydantic==2.13.4
pydantic-settings==2.14.1

# HTTP client
httpx==0.28.1

# Streamlit dashboard
streamlit==1.57.0

# A2A protocol (Agent-to-Agent)
# Note: use core a2a-sdk only (no [http-server] extra) — we bring our own FastAPI/Starlette.
# sse-starlette 2.x is the last series compatible with starlette 0.46.x.
# protobuf is NOT hard-pinned here: langchain-google-genai → grpcio-status requires >=6.31.1,
# while a2a-sdk requires <7,>=5.29.5.  The compatible range is 6.31.1 ≤ protobuf < 7.
# pip-compile resolves this automatically when left unpinned.
a2a-sdk==1.0.3
sse-starlette==2.4.1

# Utilities
python-dotenv==1.2.2

# Dev / test
pip-tools==7.5.3
pytest==8.4.2
